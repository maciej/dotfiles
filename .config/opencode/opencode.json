{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lysk-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lysk Server (vLLM)",
      "options": {
        "baseURL": "http://lysk-server:8000/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B FP8 (Lysk RTX 6000)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "variants": {
            "off": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
  "model": "lysk-vllm/qwen3.8-27b",
  "small_model": "lysk-vllm/qwen3.8-27b"
}
