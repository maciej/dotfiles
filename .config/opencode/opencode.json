{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": { "/tmp/**": "allow", "/private/tmp/**": "allow" },
    "edit": { "/tmp/**": "allow", "/private/tmp/**": "allow" }
  },
  "mcp": {
    "servers": {
      "solidcraft": {
        "type": "local",
        "command": [
          "/Applications/SolidCraft.app/Contents/MacOS/solidcraft-cli",
          "mcp"
        ]
      }
    }
  }
}
